      "contracts",
      "schemas",
      "light experiment metadata",
      "reverse-pointer surfaces",
      "shared tooling",
      "operator-facing policy artifacts"
    ],
    "belongs_outside_repo": [
      "runtime outputs",
      "heavy artifacts",
      "datasets",
      "checkpoints",
      "large generated logs",
      "ephemeral execution residue"
