  "terminal_state_definitions": {
    "succeeded": {
      "summary_class": "evidence_bearing_completion",
      "description": "The job finished with durable evidence that satisfies the shape's success condition."
    },
    "failed": {
      "summary_class": "evidence_bearing_completion",
      "description": "The job finished with durable evidence of runtime or task failure."
    },
    "failed_verification": {
      "summary_class": "evidence_bearing_completion",
      "description": "The verification loop finished with durable evidence that the attempted change did not pass verification."
    },
    "proof_gap": {
      "summary_class": "evidence_bearing_completion",
      "description": "The job finished by recording an explicit proof gap instead of claiming unsupported success."
    },
    "skipped": {
      "summary_class": "evidence_bearing_completion",
      "description": "The experiment run ended without execution but with durable evidence explaining the skip."
    },
    "blocked": {
      "summary_class": "operator_actionable_terminal",
      "description": "The job stopped because some operator or dependency action is required before a retry is safe."
    },
    "deferred": {
      "summary_class": "operator_actionable_terminal",
      "description": "The job stopped without launch or continuation because policy or scheduling chose not to proceed now."
    },
    "abandoned": {
      "summary_class": "operator_actionable_terminal",
      "description": "The job instance was intentionally given up after bounded attempts or supersession."
    },
    "cancelled": {
      "summary_class": "operator_actionable_terminal",
      "description": "The job was stopped by an explicit operator or system cancellation action."
    },
    "interrupted": {
      "summary_class": "operator_actionable_terminal",
      "description": "The job stopped due to interruption without an internal resumable lifecycle answer."
    },
    "error": {
      "summary_class": "operator_actionable_terminal",
      "description": "The job ended in an unhandled execution error that still needs operator interpretation."
    }
  },
  "recovery_class_definitions": {
    "rerun_from_last_iteration_boundary": "Restart from the last build-verify iteration boundary; retry and repair policy is explicit per loop receipt.",
    "relaunch_children_from_parent_truth": "Reconstruct child launch intent from the durable parent record and relaunch only from parent truth.",
    "resume_from_durable_checkpoint_if_present": "Resume from durable checkpoint truth when present; otherwise reconcile honestly and require an explicit new launch.",
    "not_launchable_yet": "The shape is named for taxonomy completeness but must not launch until its own runtime substrate exists."
  },
