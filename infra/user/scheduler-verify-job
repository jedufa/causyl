#!/usr/bin/env bash
# infra/user/scheduler-verify-job
# Description: Verify one scheduled job or all jobs, with warnings/failures and optional stale dirty-flag cleanup.
# Example: bash infra/user/scheduler-verify-job overnight_20260314_q4a6b_rw_20_7ed3dcbf

set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"
PYTHONPATH=. python infra/bin/scheduler_verify_job.py "$@"
