#!/usr/bin/env bash
# infra/user/find
# Description: Search for a pattern in the repo while respecting `.gitignore`, defaulting to the repo root when no directory is provided.
# Example: infra/user/find single_word ./governance/ledger/
# Example default ./ repo: infra/user/find single_word

set -euo pipefail
if [[ $# -lt 1 ]]; then
  echo "Usage: $(basename "$0") <pattern> [directory]" >&2
  exit 2
fi

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
pattern=$1
dir_arg=${2:-.}

cd "$repo_root"

# Normalize the directory argument relative to the repo root.
if [[ "$dir_arg" == /* ]]; then
  dir_path=$(realpath -m "$dir_arg")
  if [[ "$dir_path" != "$repo_root"* ]]; then
    echo "Directory $dir_arg is outside the repo root $repo_root" >&2
    exit 2
  fi
  if [[ "$dir_path" == "$repo_root" ]]; then
    dir_rel="."
  else
    dir_rel=${dir_path#$repo_root/}
  fi
else
  dir_rel=${dir_arg:-.}
fi

mapfile -t files < <(git -C "$repo_root" ls-files --cached --others --exclude-standard -- "$dir_rel")

if [[ ${#files[@]} -eq 0 ]]; then
  exit 0
fi

printf '%s\0' "${files[@]}" | xargs -0 -n1 grep -il -- "$pattern"
