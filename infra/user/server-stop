#!/usr/bin/env bash
# infra/user/server-stop
# Description: Stop the WebUI server, waiting for scheduled jobs to finish.
# Example: bash infra/user/server-stop --force --yes

set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"
bash infra/bin/server_stop.sh "$@"
